@startuml
title Chat To Terraform To AWS

skinparam backgroundColor white
skinparam shadowing false
skinparam sequenceMessageAlign center

actor User
participant "Browser UI\n(ui/app.js)" as UI
participant "AGUI Backend\n/api/run" as API
participant "Run Loop" as RUNNER
participant "LLM" as LLM
participant "Intent Policy" as POLICY
participant "AWS Terraform MCP" as MCP
participant "Template Library" as TPL
participant "Terraform Manager" as TFM
participant "Terraform CLI" as TF
participant "AWS" as AWS

User -> UI : request infrastructure change
UI -> API : POST /api/run
API -> RUNNER : initialize run and profile
RUNNER --> UI : RUN_STARTED
RUNNER -> LLM : invoke(history + tools)
LLM --> RUNNER : tool call(s)
RUNNER -> POLICY : block mutating tools for read-only intents

alt create_* tool
  RUNNER -> MCP : execute_tool(create_*)
  MCP -> TPL : generate Terraform HCL
  MCP -> TFM : write project files
  TFM --> MCP : project_name
  MCP --> RUNNER : result
  RUNNER --> UI : TOOL_RESULT
end

alt terraform_plan
  RUNNER -> MCP : execute_tool(terraform_plan)
  MCP -> TFM : init(project)
  TFM -> TF : terraform init
  TF --> TFM : init output
  MCP -> TFM : plan(project)
  TFM -> TF : terraform plan -out=tfplan -input=false
  TF --> TFM : plan output
  TFM --> MCP : success or failure
  MCP --> RUNNER : plan result
  RUNNER --> UI : TOOL_RESULT
end

alt terraform_apply
  RUNNER -> MCP : execute_tool(terraform_apply)
  MCP -> TFM : apply(project)
  TFM -> TF : terraform apply tfplan
  TF -> AWS : provider operations
  AWS --> TF : resource responses
  TF --> TFM : apply output
  TFM --> MCP : success or failure
  MCP --> RUNNER : apply result
  RUNNER --> UI : TOOL_RESULT
end

RUNNER -> LLM : follow-up with tool results
LLM --> RUNNER : final answer
RUNNER --> UI : TEXT_MESSAGE_CONTENT
RUNNER --> UI : RUN_FINISHED

note right of RUNNER
The backend keeps track of the last
successful terraform_plan project and can
recover when the model sends the wrong
project_name to terraform_apply.
end note

note right of MCP
AWS mutation is intentionally Terraform-only.
Direct CLI mutation mode is deprecated.
end note

@enduml
